<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd"><FileHeader revMajor="1" revMinor="1" author="Emil Knabe" date="2020-03-01T10:00:00" description="Enforce box-in situation using Synchronize action" /><ParameterDeclarations><ParameterDeclaration name="EgoVehicle" parameterType="string" value="car_white" /><ParameterDeclaration name="NPC1Vehicle" parameterType="string" value="car_red" /><ParameterDeclaration name="NPC2Vehicle" parameterType="string" value="truck_yellow" /><ParameterDeclaration name="NPC3Vehicle" parameterType="string" value="bus_blue" /><ParameterDeclaration name="NPC4Vehicle" parameterType="string" value="car_yellow" /><ParameterDeclaration name="MS1Vehicle" parameterType="string" value="car_yellow" /><ParameterDeclaration name="MS2Vehicle" parameterType="string" value="van_red" /><ParameterDeclaration name="EgoSpeed" parameterType="double" value="20" /><ParameterDeclaration name="NPC1Speed" parameterType="double" value="${$EgoSpeed + 10}" /><ParameterDeclaration name="NPC2Speed" parameterType="double" value="0" /><ParameterDeclaration name="NPC3Speed" parameterType="double" value="${$EgoSpeed - 3}" /><ParameterDeclaration name="NPC4Speed" parameterType="double" value="0" /><ParameterDeclaration name="EgoLaneId" parameterType="integer" value="-3" /><ParameterDeclaration name="NPC1LaneId" parameterType="integer" value="-2" /><ParameterDeclaration name="NPC2LaneId" parameterType="integer" value="-3" /><ParameterDeclaration name="NPC3LaneId" parameterType="integer" value="-4" /><ParameterDeclaration name="NPC4LaneId" parameterType="integer" value="-3" /><ParameterDeclaration name="EgoStartS" parameterType="double" value="100" /><ParameterDeclaration name="NPC1StartS" parameterType="double" value="${$EgoStartS + 50}" /><ParameterDeclaration name="NPC2StartS" parameterType="double" value="${$EgoStartS - 80}" /><ParameterDeclaration name="NPC3StartS" parameterType="double" value="${$EgoStartS - 30}" /><ParameterDeclaration name="NPC4StartS" parameterType="double" value="${$EgoStartS + 70}" /><ParameterDeclaration name="MS1EgoS" parameterType="double" value="300" /><ParameterDeclaration name="MS1NPC1S" parameterType="double" value="${$MS1EgoS + 5}" /><ParameterDeclaration name="MS1NPC2S" parameterType="double" value="${$MS1EgoS - 15}" /><ParameterDeclaration name="MS1NPC3S" parameterType="double" value="${$MS1EgoS - 3}" /><ParameterDeclaration name="MS1NPC4S" parameterType="double" value="${$MS1EgoS + 30}" /><ParameterDeclaration name="MS2EgoS" parameterType="double" value="500" /><ParameterDeclaration name="AccRate" parameterType="double" value="3" /></ParameterDeclarations><CatalogLocations><VehicleCatalog><Directory path="../xosc/Catalogs/Vehicles" /></VehicleCatalog><ControllerCatalog><Directory path="../xosc/Catalogs/Controllers" /></ControllerCatalog><ManeuverCatalog><Directory path="../xosc/Catalogs/Maneuvers" /></ManeuverCatalog></CatalogLocations><RoadNetwork><LogicFile filepath="../xodr/e6mini.xodr" /><SceneGraphFile filepath="../models/e6mini.osgb" /></RoadNetwork><Entities><ScenarioObject name="Ego"><CatalogReference catalogName="VehicleCatalog" entryName="$EgoVehicle" /><ObjectController><CatalogReference catalogName="ControllerCatalog" entryName="interactiveDriver" /></ObjectController></ScenarioObject><ScenarioObject name="NPC1"><CatalogReference catalogName="VehicleCatalog" entryName="$NPC1Vehicle" /></ScenarioObject><ScenarioObject name="NPC2"><CatalogReference catalogName="VehicleCatalog" entryName="$NPC2Vehicle" /></ScenarioObject><ScenarioObject name="NPC3"><CatalogReference catalogName="VehicleCatalog" entryName="$NPC3Vehicle" /></ScenarioObject><ScenarioObject name="NPC4"><CatalogReference catalogName="VehicleCatalog" entryName="$NPC4Vehicle" /></ScenarioObject><ScenarioObject name="MS1"><CatalogReference catalogName="VehicleCatalog" entryName="$MS1Vehicle" /></ScenarioObject><ScenarioObject name="MS2"><CatalogReference catalogName="VehicleCatalog" entryName="$MS2Vehicle" /></ScenarioObject></Entities><Storyboard><Init><Actions><Private entityRef="Ego"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="$EgoLaneId" s="$EgoStartS" offset="0.0" /></Position></TeleportAction></PrivateAction><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionTarget><AbsoluteTargetSpeed value="$EgoSpeed" /></SpeedActionTarget><SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" /></SpeedAction></LongitudinalAction></PrivateAction></Private><Private entityRef="NPC1"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="$NPC1LaneId" s="$NPC1StartS" offset="0.0" /></Position></TeleportAction></PrivateAction></Private><Private entityRef="NPC2"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="$NPC2LaneId" s="$NPC2StartS" offset="0.0" /></Position></TeleportAction></PrivateAction></Private><Private entityRef="NPC3"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="$NPC3LaneId" s="$NPC3StartS" offset="0.0" /></Position></TeleportAction></PrivateAction></Private><Private entityRef="NPC4"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="$NPC4LaneId" s="$NPC4StartS" offset="0.0" /></Position></TeleportAction></PrivateAction></Private><Private entityRef="MS1"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="-5" s="$MS1EgoS" offset="0.0" /></Position></TeleportAction></PrivateAction></Private><Private entityRef="MS2"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="-5" s="$MS2EgoS" offset="0.0" /></Position></TeleportAction></PrivateAction></Private></Actions></Init><Story name="Synchronize_Story"><ParameterDeclarations><ParameterDeclaration name="owner" parameterType="string" value="Ego" /></ParameterDeclarations><Act name="Synchronize_Act"><ManeuverGroup name="Synchronize_NPC1_Sequence" maximumExecutionCount="1"><Actors selectTriggeringEntities="false"><EntityRef entityRef="NPC1" /></Actors></ManeuverGroup><ManeuverGroup name="Synchronize_NPC2_Sequence" maximumExecutionCount="1"><Actors selectTriggeringEntities="false"><EntityRef entityRef="NPC2" /></Actors></ManeuverGroup><ManeuverGroup name="Synchronize_NPC3_Sequence" maximumExecutionCount="1"><Actors selectTriggeringEntities="false"><EntityRef entityRef="NPC3" /></Actors></ManeuverGroup><ManeuverGroup name="Synchronize_NPC4_Sequence" maximumExecutionCount="1"><Actors selectTriggeringEntities="false"><EntityRef entityRef="NPC4" /></Actors></ManeuverGroup><StartTrigger><ConditionGroup><Condition name="Synchronize_Condition" delay="0.0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition rule="greaterThan" value="0.0" /></ByValueCondition></Condition></ConditionGroup></StartTrigger></Act></Story><StopTrigger><ConditionGroup><Condition name="EndCondition1" delay="0.0" conditionEdge="none"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Ego" /></TriggeringEntities><EntityCondition><TraveledDistanceCondition value="5.0" /></EntityCondition></ByEntityCondition></Condition><Condition name="EndCondition2" delay="0.0" conditionEdge="none"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="NPC4" /></TriggeringEntities></ByEntityCondition></Condition></ConditionGroup><ConditionGroup><Condition name="StopSimulationCondition" delay="0.0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition rule="greaterThan" value="1200.0" /></ByValueCondition></Condition></ConditionGroup></StopTrigger></Storyboard></OpenSCENARIO>