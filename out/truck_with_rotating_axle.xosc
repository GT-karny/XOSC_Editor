<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="1" author="esmini-team" date="2023-09-11T10:00:00" description="Single truck vehicle, following trajectory" />
  <ParameterDeclarations />
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <SceneGraphFile filepath="../models/parking_lot.osgb" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Truck">
      <CatalogReference catalogName="VehicleCatalog" entryName="semi_truck_with_extra_trailer_rotating_axle" />
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Truck">
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="5.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="linear" value="5.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <RoutingAction>
              <FollowTrajectoryAction>
                <Trajectory name="TrajectoryNurbs" closed="false">
                  <Shape>
                    <Nurbs order="3">
                      <ControlPoint weight="1.0">
                        <Position>
                          <WorldPosition x="20.0" y="0.0" />
                        </Position>
                      </ControlPoint>
                      <ControlPoint weight="1.0">
                        <Position>
                          <WorldPosition x="30.0" y="0.0" />
                        </Position>
                      </ControlPoint>
                      <ControlPoint weight="1.0">
                        <Position>
                          <WorldPosition x="60.0" y="30.0" />
                        </Position>
                      </ControlPoint>
                      <ControlPoint weight="1.0">
                        <Position>
                          <WorldPosition x="90.0" y="-30.0" />
                        </Position>
                      </ControlPoint>
                      <ControlPoint weight="1.0">
                        <Position>
                          <WorldPosition x="120.0" y="0.0" />
                        </Position>
                      </ControlPoint>
                      <ControlPoint weight="1.0">
                        <Position>
                          <WorldPosition x="150.0" y="0.0" />
                        </Position>
                      </ControlPoint>
                      <Knot value="0.0" />
                      <Knot value="0.0" />
                      <Knot value="0.0" />
                      <Knot value="0.25" />
                      <Knot value="0.5" />
                      <Knot value="0.75" />
                      <Knot value="1.0" />
                      <Knot value="1.0" />
                      <Knot value="1.0" />
                    </Nurbs>
                  </Shape>
                </Trajectory>
                <TimeReference>
                  <None />
                </TimeReference>
                <TrajectoryFollowingMode followingMode="position" />
              </FollowTrajectoryAction>
            </RoutingAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="MyStory">
      <Act name="DummyAct">
        <ManeuverGroup name="DummyManueverGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false" />
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="DefaultStartCondition" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="0.0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="starttrigger" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition rule="greaterThan" value="38.0" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>