<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="1" author="esmini-team" date="2022-03-10T10:00:00" description="Single truck vehicle, interactive control and no maneuvers" />
  <ParameterDeclarations />
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
    <ControllerCatalog>
      <Directory path="../xosc/Catalogs/Controllers" />
    </ControllerCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <SceneGraphFile filepath="../models/parking_lot.osgb" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Truck">
      <CatalogReference catalogName="VehicleCatalog" entryName="semi_truck_with_extra_trailer" />
      <ObjectController>
        <CatalogReference catalogName="ControllerCatalog" entryName="interactiveDriver">
          <ParameterAssignments>
            <ParameterAssignment parameterRef="SteeringRate" value="1.0" />
          </ParameterAssignments>
        </CatalogReference>
      </ObjectController>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Truck">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="1.8" y="-358.0" h="1.57" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <ActivateControllerAction longitudinal="true" lateral="true" />
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="MyStory">
      <Act name="DummyAct">
        <ManeuverGroup name="DummyManueverGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false" />
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="StartTrigger" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterOrEqual" value="0.0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="StopSimulationCondition" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition rule="greaterThan" value="1200.0" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>