<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="0" author="esmini-team" date="2019-06-09T10:00:00" description="Cut-in" />
  <ParameterDeclarations>
    <ParameterDeclaration name="HostVehicle" parameterType="string" value="car_white" />
    <ParameterDeclaration name="EgoStartS" parameterType="double" value="50" />
    <ParameterDeclaration name="TargetVehicle" parameterType="string" value="car_red" />
    <ParameterDeclaration name="DummyParameter" parameterType="double" value="2" />
    <ParameterDeclaration name="DummyParameter2" parameterType="boolean" value="true" />
    <ParameterDeclaration name="DummyParameter3" parameterType="string" value="lane_change_param" />
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../xodr/jolengatan.xodr" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <CatalogReference catalogName="VehicleCatalog" entryName="$HostVehicle" />
    </ScenarioObject>
    <ScenarioObject name="Truck">
      <CatalogReference catalogName="VehicleCatalog" entryName="semi_truck_with_extra_trailer" />
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" s="50.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="20.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Truck">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="1" s="300.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="20.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="Lane change story">
      <ParameterDeclarations>
        <ParameterDeclaration name="owner" parameterType="string" value="Ego" />
      </ParameterDeclarations>
      <Act name="Lane change act">
        <ManeuverGroup name="Lane change" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="$owner" />
          </Actors>
          <Maneuver name="Lane change Ego maneuver">
            <Event name="Lane change Ego event" priority="overwrite">
              <Action name="Lane change Ego action">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeTarget>
                        <RelativeTargetLane value="1" entityRef="Ego" />
                      </LaneChangeTarget>
                      <LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="2.0" />
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="Lane change Ego condition" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="4.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="EgoGoOffRoadEvent" priority="parallel">
              <Action name="EgoGoOffRoadAction" />
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EgoGoOffRoadCondition" delay="1.0" conditionEdge="rising">
                    <ByValueCondition>
                      <StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="Lane change Ego event" state="endTransition" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="EgoGoOnRoadEvent" priority="overwrite">
              <Action name="EgoGoOnRoadAction" />
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EgoGoOnRoadCondition" delay="0.0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego" />
                      </TriggeringEntities>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup name="Lane change 2" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Truck" />
          </Actors>
          <Maneuver name="Lane change Target maneuver">
            <Event name="Lane change Target event" priority="overwrite">
              <Action name="Lane change Target action">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeTarget>
                        <RelativeTargetLane value="1" entityRef="Truck" />
                      </LaneChangeTarget>
                      <LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="2.0" />
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger />
            </Event>
            <Event name="Dummy parameter event" priority="parallel">
              <Action name="Dummy parameter action" />
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="Lane change Target condition" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="3.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="CutInActStart" delay="0.0" conditionEdge="risingOrFalling">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="0.0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="QuitCondition" delay="3.0" conditionEdge="rising">
          <ByValueCondition>
            <StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="EgoGoOnRoadEvent" state="endTransition" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>