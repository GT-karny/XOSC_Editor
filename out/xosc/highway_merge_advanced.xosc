<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="0" author="SimS" date="2017-11-27T10:00:00" description="Advanced Highway Merge with disrespectful driver" />
  <ParameterDeclarations>
    <ParameterDeclaration name="gap_normal" parameterType="double" value="20" />
    <ParameterDeclaration name="gap_small" parameterType="double" value="7" />
    <ParameterDeclaration name="lat_limit" parameterType="double" value="3.25" />
    <ParameterDeclaration name="max_acc" parameterType="double" value="10" />
    <ParameterDeclaration name="max_ret" parameterType="double" value="7" />
    <ParameterDeclaration name="max_speed" parameterType="double" value="50" />
    <ParameterDeclaration name="A1_speed" parameterType="double" value="12" />
    <ParameterDeclaration name="Ego_speed" parameterType="double" value="15" />
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
    <ControllerCatalog>
      <Directory path="../xosc/Catalogs/Controllers" />
    </ControllerCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../xodr/soderleden.xodr" />
    <SceneGraphFile filepath="../models/soderleden.osgb" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_white" />
      <ObjectController>
        <CatalogReference catalogName="ControllerCatalog" entryName="interactiveDriver" />
      </ObjectController>
    </ScenarioObject>
    <ScenarioObject name="A1">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_police" />
    </ScenarioObject>
    <ScenarioObject name="A2">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_blue" />
    </ScenarioObject>
    <ScenarioObject name="A3">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow" />
    </ScenarioObject>
    <ScenarioObject name="A4">
      <CatalogReference catalogName="VehicleCatalog" entryName="scooter" />
    </ScenarioObject>
    <ScenarioObject name="A5">
      <CatalogReference catalogName="VehicleCatalog" entryName="bus_blue" />
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" s="18.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <ActivateControllerAction longitudinal="true" lateral="true" />
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="12.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="A1">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="2" laneId="-2" s="120.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$A1_speed" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="A2">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="2" laneId="-2" s="100.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$A1_speed" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="A3">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="2" laneId="-2" s="83.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <RelativeTargetSpeed entityRef="A1" value="0" speedTargetValueType="delta" continuous="false" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="A4">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="2" laneId="-1" s="60.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="25.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="A5">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="2" laneId="-1" s="10.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <RelativeTargetSpeed entityRef="A4" value="0.0" speedTargetValueType="delta" continuous="true" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="Highway_Merge_Story">
      <ParameterDeclarations>
        <ParameterDeclaration name="owner" parameterType="string" value="Ego" />
      </ParameterDeclarations>
      <Act name="EgoAct">
        <ManeuverGroup name="Highway_Merge_SequenceEgo" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Ego" />
          </Actors>
          <Maneuver name="EgoLaneChange">
            <Event name="EgoLaneChangeEvent" priority="overwrite">
              <Action name="EgoLaneChangeAction">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeTarget>
                        <AbsoluteTargetLane value="-2" />
                      </LaneChangeTarget>
                      <LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="2.8" />
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EgoLaneChangeCondition" delay="0.0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <ReachPositionCondition tolerance="1.0">
                          <Position>
                            <LanePosition roadId="0" laneId="-3" s="20.0" offset="0.0" />
                          </Position>
                        </ReachPositionCondition>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup name="Highway_Merge_SequenceA3" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="A3" />
          </Actors>
          <Maneuver name="A3DistManuever">
            <Event name="A3CloseEvent" priority="overwrite">
              <Action name="A3CloseAction" />
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="A3CloseGapStartCondition" delay="0.0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="A3" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition entityRef="$owner" freespace="false" relativeDistanceType="lateral" rule="lessThan" value="$lat_limit" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                  <Condition name="LongitudinalDistanceCondition" delay="0.0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="all">
                        <EntityRef entityRef="A3" />
                        <EntityRef entityRef="A2" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition entityRef="$owner" freespace="true" relativeDistanceType="cartesianDistance" rule="lessThan" value="30.0" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="A3OpenEvent" priority="overwrite">
              <Action name="A3OpenAction" />
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="A3OpenGapStartCondition" delay="0.0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="A3" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition entityRef="$owner" freespace="false" relativeDistanceType="lateral" rule="greaterThan" value="$lat_limit" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                  <Condition name="LongitudinalDistanceCondition" delay="0.0" conditionEdge="none">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="all">
                        <EntityRef entityRef="A3" />
                        <EntityRef entityRef="A2" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition entityRef="$owner" freespace="true" relativeDistanceType="cartesianDistance" rule="lessThan" value="30.0" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition delay="0.0" conditionEdge="rising">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="0.0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="QuitCondition" delay="5.0" conditionEdge="rising">
          <ByValueCondition>
            <StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="EgoLaneChangeEvent" state="endTransition" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
      <ConditionGroup>
        <Condition name="StopSimulationCondition" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition rule="greaterThan" value="1200.0" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>