<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="0" author="Mandolin" date="2020-08-14T08:57:00" description="adaptspeed_example" />
  <ParameterDeclarations />
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
    <ControllerCatalog>
      <Directory path="../xosc/Catalogs/Controllers" />
    </ControllerCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../xodr/e6mini.xodr" />
    <SceneGraphFile filepath="../models/e6mini.osgb" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="car_white" vehicleCategory="car">
        <ParameterDeclarations />
        <BoundingBox>
          <Center x="2.0" y="0.0" z="0.9" />
          <Dimensions height="1.8" length="5.0" width="2.0" />
        </BoundingBox>
        <Performance maxAcceleration="10.0" maxDeceleration="10.0" maxSpeed="69.0" />
        <Axles>
          <FrontAxle>
            <Axle maxSteering="30.0" positionX="2.98" positionZ="0.4" trackWidth="1.68" wheelDiameter="0.8" />
          </FrontAxle>
          <RearAxle>
            <Axle maxSteering="30.0" positionX="0.0" positionZ="0.4" trackWidth="1.68" wheelDiameter="0.8" />
          </RearAxle>
        </Axles>
        <Properties />
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="Target1">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_red" />
    </ScenarioObject>
    <ScenarioObject name="SumoVehicles">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_yellow" />
      <ObjectController>
        <CatalogReference catalogName="ControllerCatalog" entryName="sumoController">
          <ParameterAssignments>
            <ParameterAssignment parameterRef="OverrideVehicleScaleMode" value="BBToModel" />
          </ParameterAssignments>
        </CatalogReference>
      </ObjectController>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="3.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="1.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="0" laneId="-3" s="1.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Target1">
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="1.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="1.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="0" laneId="-2" s="1.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="mystory">
      <ParameterDeclarations />
      <Act name="my act">
        <ManeuverGroup name="mangroup_red" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Target1" />
          </Actors>
          <Maneuver name="red_speed">
            <Event name="targetspeedincrease" priority="overwrite">
              <Action name="targetspeed">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="25.0" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="6.0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="starttrigger" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="13.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
          <Maneuver name="red_overtake">
            <Event name="first_lane_change" priority="overwrite">
              <Action name="lane_change_red">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeTarget>
                        <AbsoluteTargetLane value="-3" />
                      </LaneChangeTarget>
                      <LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="4.0" />
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="redtrigger" delay="0.2" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <TimeHeadwayCondition entityRef="Target1" value="0.1" freespace="true" coordinateSystem="entity" relativeDistanceType="longitudinal" rule="greaterThan" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup name="mangroup_ego" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Ego" />
          </Actors>
          <Maneuver name="ego_speed">
            <Event name="egospeedincrease" priority="overwrite">
              <Action name="egospeed">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="20.0" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="linear" value="10.0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="starttrigger" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="13.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="starttrigger" delay="0.0" conditionEdge="rising">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="0.0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="stop_simulation" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition rule="greaterThan" value="40.0" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>