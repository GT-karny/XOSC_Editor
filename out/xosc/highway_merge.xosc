<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd"><FileHeader revMajor="1" revMinor="0" author="SimS" date="2017-11-27T10:00:00" description="A basic lane merge scenario" /><ParameterDeclarations><ParameterDeclaration name="Gap1_time" parameterType="double" value="2.5" /><ParameterDeclaration name="Gap2_time" parameterType="double" value="3" /><ParameterDeclaration name="Max_acc" parameterType="double" value="2" /><ParameterDeclaration name="Max_ret" parameterType="double" value="5" /><ParameterDeclaration name="A1_speed" parameterType="double" value="25" /></ParameterDeclarations><CatalogLocations><VehicleCatalog><Directory path="../xosc/Catalogs/Vehicles" /></VehicleCatalog></CatalogLocations><RoadNetwork><LogicFile filepath="../xodr/soderleden.xodr" /><SceneGraphFile filepath="../models/soderleden.osgb" /></RoadNetwork><Entities><ScenarioObject name="Ego"><CatalogReference catalogName="VehicleCatalog" entryName="car_white" /></ScenarioObject><ScenarioObject name="A1"><CatalogReference catalogName="VehicleCatalog" entryName="car_police" /></ScenarioObject><ScenarioObject name="A2"><CatalogReference catalogName="VehicleCatalog" entryName="car_blue" /></ScenarioObject><ScenarioObject name="A3"><CatalogReference catalogName="VehicleCatalog" entryName="car_yellow" /></ScenarioObject><ScenarioObject name="A4"><CatalogReference catalogName="VehicleCatalog" entryName="scooter" /></ScenarioObject><ScenarioObject name="A5"><CatalogReference catalogName="VehicleCatalog" entryName="bus_blue" /></ScenarioObject></Entities><Storyboard><Init><Actions><Private entityRef="Ego"><PrivateAction><TeleportAction><Position><LanePosition roadId="1" laneId="-1" s="10.0" offset="0.0" /></Position></TeleportAction></PrivateAction><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionTarget><AbsoluteTargetSpeed value="25.0" /></SpeedActionTarget><SpeedActionDynamics dynamicsDimension="time" dynamicsShape="ste