<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="2" author="esmini-team" date="2021-11-18T10:00:00" description="Demonstrate OSC 1.2 speedProfileAction" />
  <ParameterDeclarations>
    <ParameterDeclaration name="StartTime" parameterType="double" value="2.0" />
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../xodr/straight_500m.xodr" />
    <SceneGraphFile filepath="../models/straight_500m.osgb" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Car1">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_white" />
    </ScenarioObject>
    <ScenarioObject name="Car2">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_red" />
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Car1">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" s="10.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="Car2">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" s="10.0" offset="3.07" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="SpeedProfileStory">
      <ParameterDeclarations />
      <Act name="SpeedProfileAct">
        <ManeuverGroup name="SpeedProfileManeuverGroup1" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Car1" />
          </Actors>
          <Maneuver name="SpeedProfileManeuver1">
            <Event name="SpeedProfileEvent1" priority="overwrite">
              <Action name="SpeedProfileAction1" />
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EventTrigger1" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterOrEqual" value="$StartTime" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <ManeuverGroup name="SpeedProfileManeuverGroup2" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Car2" />
          </Actors>
          <Maneuver name="SpeedProfileManeuver2">
            <Event name="SpeedProfileEvent" priority="overwrite">
              <Action name="SpeedProfileAction2" />
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EventTrigger2" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterOrEqual" value="$StartTime" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="DefaultStartCondition" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="0.0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="StopSimulationCondition" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition rule="greaterThan" value="14.0" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>