<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="1" author="esmini-team" date="2020-10-04T10:00:00" description="Demonstrate controller concept" />
  <ParameterDeclarations>
    <ParameterDeclaration name="EgoVehicle" parameterType="string" value="car_white" />
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
    <ControllerCatalog>
      <Directory path="../xosc/Catalogs/Controllers" />
    </ControllerCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../xodr/curve_r100.xodr" />
    <SceneGraphFile filepath="../models/curve_r100.osgb" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <CatalogReference catalogName="VehicleCatalog" entryName="$EgoVehicle" />
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="0" laneId="-1" s="20.0" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="15.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="Story">
      <Act name="Act">
        <ManeuverGroup name="EgoManueverGroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Ego" />
          </Actors>
          <Maneuver name="ControllerManuever">
            <Event name="SloppyDriverEvent" priority="overwrite">
              <Action name="AssignSloppyDriverControllerAction" />
              <Action name="ActivateSloppyDriverControllerAction">
                <PrivateAction>
                  <ActivateControllerAction longitudinal="false" lateral="true" />
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="SloppyDriverCondition" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="2.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="LateralnteractiveEvent" priority="overwrite">
              <Action name="AssignInteractiveControllerAction" />
              <Action name="ActivateInteractiveDriverControllerActionLateral">
                <PrivateAction>
                  <ActivateControllerAction longitudinal="false" lateral="true" />
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="InteractiveDriverLateralCondition" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="10.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="LongitudinalInteractiveInteractiveEvent" priority="overwrite">
              <Action name="AssignLongitudinalInteractiveControllerAction" />
              <Action name="ActivateInteractiveDriverControllerActionLongitudinal">
                <PrivateAction>
                  <ActivateControllerAction longitudinal="true" lateral="false" />
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="InteractiveDriverLongitudinalCondition" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="20.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="BetterSloppyDriverEvent" priority="overwrite">
              <Action name="AssignBetterSloppyDriverControllerAction" />
              <Action name="ActivateBetterSloppyDriverControllerAction">
                <PrivateAction>
                  <ActivateControllerAction longitudinal="true" lateral="false" />
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="BetterSloppyDriverCondition" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="30.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="DefaultControllerEvent" priority="overwrite">
              <Action name="ActivateDefaultControllerAction">
                <PrivateAction>
                  <ActivateControllerAction longitudinal="false" lateral="false" />
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="DefaultControllerCondition" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="40.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="0.0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="QuitWhenReachPositionCondition" delay="0.0" conditionEdge="none">
          <ByEntityCondition>
            <TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="Ego" />
            </TriggeringEntities>
            <EntityCondition>
              <ReachPositionCondition tolerance="10.0">
                <Position>
                  <LanePosition roadId="0" laneId="0" s="750.0" offset="0.0" />
                </Position>
              </ReachPositionCondition>
            </EntityCondition>
          </ByEntityCondition>
        </Condition>
      </ConditionGroup>
      <ConditionGroup>
        <Condition name="StopSimulationCondition" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition rule="greaterThan" value="1200.0" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>