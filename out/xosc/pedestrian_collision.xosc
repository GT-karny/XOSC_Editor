<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="0" author="esmini-team" date="2020-10-02T10:00:00" description="Pedestrian involved in a critical situation. Car fails to brake." />
  <ParameterDeclarations>
    <ParameterDeclaration name="HostVehicle" parameterType="string" value="car_white" />
    <ParameterDeclaration name="HostSpeed" parameterType="double" value="9" />
    <ParameterDeclaration name="PedestrianSpeed" parameterType="double" value="1.6" />
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
    <RouteCatalog>
      <Directory path="../xosc/Catalogs/Routes" />
    </RouteCatalog>
    <PedestrianCatalog>
      <Directory path="../xosc/Catalogs/Pedestrians" />
    </PedestrianCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../xodr/fabriksgatan.xodr" />
    <SceneGraphFile filepath="../models/fabriksgatan.osgb" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <CatalogReference catalogName="VehicleCatalog" entryName="$HostVehicle" />
    </ScenarioObject>
    <ScenarioObject name="pedestrian_adult">
      <CatalogReference catalogName="PedestrianCatalog" entryName="pedestrian_adult" />
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <RoutingAction>
              <AssignRouteAction>
                <CatalogReference catalogName="RoutesAtFabriksgatan" entryName="HostStraightRoute" />
              </AssignRouteAction>
            </RoutingAction>
          </PrivateAction>
          <PrivateAction>
            <TeleportAction>
              <Position>
                <RoutePosition>
                  <RouteRef>
                    <CatalogReference catalogName="RoutesAtFabriksgatan" entryName="HostStraightRoute" />
                  </RouteRef>
                  <InRoutePosition>
                    <FromLaneCoordinates pathS="0.0" laneId="1" />
                  </InRoutePosition>
                </RoutePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$HostSpeed" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="pedestrian_adult">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="0" laneId="3" s="15.0" offset="0.5">
                  <Orientation type="relative" />
                </LanePosition>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="LTAPStory">
      <ParameterDeclarations>
        <ParameterDeclaration name="owner" parameterType="string" value="NPC" />
      </ParameterDeclarations>
      <Act name="LTAPActNPC">
        <ManeuverGroup name="ped_mangroup" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="pedestrian_adult" />
          </Actors>
          <Maneuver name="ped_maneuver">
            <Event name="ped_walk_event" priority="overwrite">
              <Action name="walk_speed">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$PedestrianSpeed" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="rate" dynamicsShape="linear" value="2.0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <Action name="walk_route">
                <PrivateAction>
                  <RoutingAction>
                    <FollowTrajectoryAction>
                      <Trajectory name="ped_traj" closed="false">
                        <Shape>
                          <Polyline>
                            <Vertex time="0.0">
                              <Position>
                                <LanePosition roadId="0" laneId="3" s="15.0" offset="0.5">
                                  <Orientation type="relative" />
                                </LanePosition>
                              </Position>
                            </Vertex>
                            <Vertex time="0.0">
                              <Position>
                                <LanePosition roadId="0" laneId="3" s="10.5" offset="0.5">
                                  <Orientation type="relative" />
                                </LanePosition>
                              </Position>
                            </Vertex>
                            <Vertex time="0.0">
                              <Position>
                                <LanePosition roadId="0" laneId="3" s="10.0" offset="0.0">
                                  <Orientation type="relative" h="1.57" />
                                </LanePosition>
                              </Position>
                            </Vertex>
                            <Vertex time="0.0">
                              <Position>
                                <LanePosition roadId="0" laneId="-3" s="10.0" offset="0.0">
                                  <Orientation type="relative" h="4.71" />
                                </LanePosition>
                              </Position>
                            </Vertex>
                            <Vertex time="0.0">
                              <Position>
                                <LanePosition roadId="0" laneId="-3" s="9.5" offset="-0.5">
                                  <Orientation type="relative" h="3.14" />
                                </LanePosition>
                              </Position>
                            </Vertex>
                            <Vertex time="0.0">
                              <Position>
                                <LanePosition roadId="0" laneId="-3" s="0.0" offset="-0.5">
                                  <Orientation type="relative" h="3.14" />
                                </LanePosition>
                              </Position>
                            </Vertex>
                          </Polyline>
                        </Shape>
                      </Trajectory>
                      <TimeReference>
                        <None />
                      </TimeReference>
                      <TrajectoryFollowingMode followingMode="follow" />
                    </FollowTrajectoryAction>
                  </RoutingAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ped_walk_event" delay="0.0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <TraveledDistanceCondition value="1.0" />
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="ped_collide_event" priority="overwrite">
              <Action name="fall_action">
                <PrivateAction>
                  <TeleportAction>
                    <Position>
                      <RelativeObjectPosition entityRef="pedestrian_adult" dx="0.0" dy="0.0">
                        <Orientation type="relative" r="1.57" />
                      </RelativeObjectPosition>
                    </Position>
                  </TeleportAction>
                </PrivateAction>
              </Action>
              <Action name="be_still_action">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="0.0" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ped_fall_condition" delay="0.0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="Ego" />
                      </TriggeringEntities>
                      <EntityCondition>
                        <CollisionCondition>
                          <EntityRef entityRef="pedestrian_adult" />
                        </CollisionCondition>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="ped_raise_event" priority="overwrite">
              <Action name="raise_action">
                <PrivateAction>
                  <TeleportAction>
                    <Position>
                      <RelativeObjectPosition entityRef="pedestrian_adult" dx="0.0" dy="0.0" dz="0.1">
                        <Orientation type="relative" r="-1.57" />
                      </RelativeObjectPosition>
                    </Position>
                  </TeleportAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ped_raise_condition" delay="0.8" conditionEdge="rising">
                    <ByValueCondition>
                      <StoryboardElementStateCondition storyboardElementType="action" storyboardElementRef="be_still_action" state="endTransition" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStartCondition" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <SimulationTimeCondition rule="greaterThan" value="0.0" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="QuitCondition" delay="3.0" conditionEdge="rising">
          <ByValueCondition>
            <StoryboardElementStateCondition storyboardElementType="action" storyboardElementRef="raise_action" state="completeState" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>