<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd">
  <FileHeader revMajor="1" revMinor="1" author="esmini-team" date="2020-10-07T10:00:00" description="basic demonstration of the ghost concept" />
  <ParameterDeclarations>
    <ParameterDeclaration name="EgoVehicle" parameterType="string" value="car_white_hybrid" />
    <ParameterDeclaration name="EgoStartS" parameterType="double" value="50" />
  </ParameterDeclarations>
  <CatalogLocations>
    <VehicleCatalog>
      <Directory path="../xosc/Catalogs/Vehicles" />
    </VehicleCatalog>
    <ControllerCatalog>
      <Directory path="../xosc/Catalogs/Controllers" />
    </ControllerCatalog>
  </CatalogLocations>
  <RoadNetwork>
    <LogicFile filepath="../xodr/e6mini.xodr" />
    <SceneGraphFile filepath="../models/e6mini.osgb" />
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="Ego">
      <CatalogReference catalogName="VehicleCatalog" entryName="car_white" />
      <ObjectController>
        <CatalogReference catalogName="ControllerCatalog" entryName="followGhost">
          <ParameterAssignments>
            <ParameterAssignment parameterRef="$HeadStartTime" value="2.5" />
            <ParameterAssignment parameterRef="$FollowMode" value="position" />
            <ParameterAssignment parameterRef="LookaheadSpeed" value="0.5" />
            <ParameterAssignment parameterRef="MinLookaheadSpeed" value="7.0" />
            <ParameterAssignment parameterRef="LookaheadSteering" value="0.5" />
            <ParameterAssignment parameterRef="MinLookaheadSteering" value="7.0" />
          </ParameterAssignments>
        </CatalogReference>
      </ObjectController>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="0" laneId="-3" s="$EgoStartS" offset="0.0" />
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="0.0" />
                </SpeedActionTarget>
                <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" />
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
          <PrivateAction>
            <ActivateControllerAction longitudinal="true" lateral="true" />
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="Story">
      <ParameterDeclarations>
        <ParameterDeclaration name="owner" parameterType="string" value="Ego" />
      </ParameterDeclarations>
      <Act name="Act">
        <ManeuverGroup name="Sequence" maximumExecutionCount="1">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="Ego" />
          </Actors>
          <Maneuver name="Maneuver1">
            <Event name="SpeedEvent1" priority="overwrite">
              <Action name="SpeedChange">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="${100/3.6}" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="linear" value="2.0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="FirstSpeedCondition" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                      <StoryboardElementStateCondition storyboardElementType="story" storyboardElementRef="Story" state="runningState" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="LaneChange1" priority="overwrite">
              <Action name="LaneChangeAction1">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeTarget>
                        <AbsoluteTargetLane value="-2" />
                      </LaneChangeTarget>
                      <LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="2.0" />
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="LaneChangeCondition1" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="6.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="LaneChange2" priority="overwrite">
              <Action name="LaneChangeAction2">
                <PrivateAction>
                  <LateralAction>
                    <LaneChangeAction>
                      <LaneChangeTarget>
                        <AbsoluteTargetLane value="-3" />
                      </LaneChangeTarget>
                      <LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="2.0" />
                    </LaneChangeAction>
                  </LateralAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="LaneChangeCondition2" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="9.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="SpeedEvent2" priority="overwrite">
              <Action name="SpeedChange2">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="10.0" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="time" dynamicsShape="linear" value="2.0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="SpeedCondition1" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="12.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="StopEvent" priority="overwrite">
              <Action name="Stop">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="0.0" />
                      </SpeedActionTarget>
                      <SpeedActionDynamics dynamicsDimension="rate" dynamicsShape="linear" value="10.0" />
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="StopCondition" delay="0.0" conditionEdge="rising">
                    <ByValueCondition>
                      <SimulationTimeCondition rule="greaterThan" value="15.0" />
                    </ByValueCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStart" delay="0.0" conditionEdge="none">
              <ByValueCondition>
                <StoryboardElementStateCondition storyboardElementType="story" storyboardElementRef="Story" state="runningState" />
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="StopCondition" delay="6.0" conditionEdge="none">
          <ByValueCondition>
            <StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="StopEvent" state="completeState" />
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>