rgetTolerance="1.0"><TargetPositionMaster><LanePosition roadId="0" laneId="1" s="$EgoSyncPoint1S" offset="0.0" /></TargetPositionMaster><TargetPosition><RoutePosition><RouteRef><CatalogReference catalogName="RoutesAtFabriksgatan" entryName="TargetLeftTurnRoute" /></RouteRef><InRoutePosition><FromLaneCoordinates pathS="203.0" laneId="-1" /></InRoutePosition></RoutePosition></TargetPosition><FinalSpeed><AbsoluteSpeed value="$NPCFinalSpeed" /></FinalSpeed></SynchronizeAction></PrivateAction></Action><StartTrigger><ConditionGroup><Condition name="SyncConditionNPC" delay="0.0" conditionEdge="none"><ByValueCondition><StoryboardElementStateCondition storyboardElementType="act" storyboardElementRef="LTAPActNPC" state="startTransition" /></ByValueCondition></Condition></ConditionGroup></StartTrigger></Event></Maneuver></ManeuverGroup><StartTrigger><ConditionGroup><Condition name="LtapActStartConditionNPC" delay="0.0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition rule="greaterThan" value="0.0" /></ByValueCondition></Condition></ConditionGroup></StartTrigger></Act></Story><StopTrigger><ConditionGroup><Condition name="DoneCondition" delay="0.0" conditionEdge="none"><ByValueCondition><StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="SyncEvent" state="completeState" /></ByValueCondition></Condition><Condition name="QuitCondition" delay="4.0" conditionEdge="rising"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="NPC" /></TriggeringEntities></ByEntityCondition></Condition></ConditionGroup><ConditionGroup><Condition name="StopSimulationCondition" delay="0.0" conditionEdge="rising"><ByValueCondition><SimulationTimeCondition rule="greaterThan" value="1200.0" /></ByValueCondition></Condition></ConditionGroup></StopTrigger></Storyboard></OpenSCENARIO>