<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd"><FileHeader revMajor="1" revMinor="0" author="esmini-team" date="2017-06-09T10:00:00" description="Basic lane change repeated after reaching end-of-road" /><ParameterDeclarations><ParameterDeclaration name="EgoVehicle" parameterType="string" value="car_white" /></ParameterDeclarations><CatalogLocations><VehicleCatalog><Directory path="../xosc/Catalogs/Vehicles" /></VehicleCatalog></CatalogLocations><RoadNetwork><LogicFile filepath="../xodr/curve_r100.xodr" /></RoadNetwork><Entities><ScenarioObject name="Ego"><CatalogReference catalogName="VehicleCatalog" entryName="$EgoVehicle" /></ScenarioObject></Entities><Storyboard><Init><Actions><Private entityRef="Ego"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="-1" s="20.0" offset="0.0" /></Position></TeleportAction></PrivateAction><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionTarget><AbsoluteTargetSpeed value="25.0" /></SpeedActionTarget><SpeedActionDynamics dynamicsDimension="time" dynamicsShape="cubic" value="4.0" /></SpeedAction></LongitudinalAction></PrivateAction></Private></Actions></Init><Story name="Lane change story"><ParameterDeclarations><ParameterDeclaration name="owner" parameterType="string" value="Ego" /></ParameterDeclarations><Act name="Lane change act"><ManeuverGroup name="Lane change maneuver group" maximumExecutionCount="1"><Actors selectTriggeringEntities="false"><EntityRef entityRef="$owner" /></Actors><Maneuver name="Lane change maneuver"><Event name="Lane change event" priority="parallel"><Action name="Lane change action"><PrivateAction><LateralAction><LaneChangeAction><LaneChangeTarget><AbsoluteTargetLane value="1" /></LaneChangeTarget><LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="4.0" /></LaneChangeAction></LateralAction></PrivateAction></Action><StartTrigger><ConditionGroup><Condition name="Lane change condition" delay="0.0" conditionEdge="rising"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Ego" /></TriggeringEntities><EntityCondition><ReachPositionCondition tolerance="1.0"><Position><LanePosition roadId="0" laneId="-1" s="50.0" offset="0.0" /></Position></ReachPositionCondition></EntityCondition></ByEntityCondition></Condition></ConditionGroup></StartTrigger></Event></Maneuver><Maneuver name="End Of Road teleport maneuver"><Event name="End Of Road teleport event" priority="parallel"><Action name="End Of Road teleport action"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="-1" s="10.0" offset="0.0" /></Position></TeleportAction></PrivateAction></Action><StartTrigger><ConditionGroup><Condition name="End Of Road condition" delay="0.0" conditionEdge="rising"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Ego" /></TriggeringEntities><EntityCondition><EndOfRoadCondition duration="2.5" /></EntityCondition></ByEntityCondition></Condition></ConditionGroup></StartTrigger></Event></Maneuver><Maneuver name="End Of Road speed maneuver"><Event name="End Of Road speed event" priority="parallel"><Action name="End Of Road speed action"><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionTarget><AbsoluteTargetSpeed value="25.0" /></SpeedActionTarget><SpeedActionDynamics dynamicsDimension="time" dynamicsShape="cubic" value="4.0" /></SpeedAction></LongitudinalAction></PrivateAction></Action><StartTrigger><ConditionGroup><Condition name="End Of Road condition" delay="0.0" conditionEdge="rising"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Ego" /></TriggeringEntities><EntityCondition><EndOfRoadCondition duration="2.5" /></EntityCondition></ByEntityCondition></Condition></ConditionGroup></StartTrigger></Event></Maneuver></ManeuverGroup><StartTrigger><ConditionGroup><Condition name="CutInActStart" delay="0.0" conditionEdge="risingOrFalling"><ByValueCondition><SimulationTimeCondition rule="greaterThan" value="0.0" /></ByValueCondition></Condition></ConditionGroup></StartTrigger></Act><Act name="Lane change act 2"><ManeuverGroup name="Lane change maneuver group" maximumExecutionCount="1"><Actors selectTriggeringEntities="false"><EntityRef entityRef="$owner" /></Actors><Maneuver name="Act 2 init"><Event name="Act 2 init event" priority="overwrite"><Action name="Act 2 init speed action"><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionTarget><AbsoluteTargetSpeed value="25.0" /></SpeedActionTarget><SpeedActionDynamics dynamicsDimension="time" dynamicsShape="cubic" value="4.0" /></SpeedAction></LongitudinalAction></PrivateAction></Action></Event></Maneuver><Maneuver name="Act 2 Lane change maneuver"><Event name="Act 2 Lane change event" priority="overwrite"><Action name="Act 2 Lane change action"><PrivateAction><LateralAction><LaneChangeAction><LaneChangeTarget><AbsoluteTargetLane value="1" /></LaneChangeTarget><LaneChangeActionDynamics dynamicsDimension="time" dynamicsShape="sinusoidal" value="4.0" /></LaneChangeAction></LateralAction></PrivateAction></Action><StartTrigger><ConditionGroup><Condition name="Lane change condition" delay="0.0" conditionEdge="rising"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Ego" /></TriggeringEntities><EntityCondition><ReachPositionCondition tolerance="1.0"><Position><LanePosition roadId="0" laneId="-1" s="50.0" offset="0.0" /></Position></ReachPositionCondition></EntityCondition></ByEntityCondition></Condition></ConditionGroup></StartTrigger></Event></Maneuver><Maneuver name="Act 2 End Of Road teleport maneuver"><Event name="Act 2 End Of Road teleport event" priority="overwrite"><Action name="Act 2 End Of Road teleport action"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="-1" s="10.0" offset="0.0" /></Position></TeleportAction></PrivateAction></Action><StartTri