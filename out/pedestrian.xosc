<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../Schema/OpenSCENARIO.xsd"><FileHeader revMajor="1" revMinor="1" author="esmini-team" date="2020-10-02T10:00:00" description="Pedestrian involved in a critical situation" /><ParameterDeclarations><ParameterDeclaration name="HostVehicle" parameterType="string" value="car_white" /><ParameterDeclaration name="HostSpeed" parameterType="double" value="10" /><ParameterDeclaration name="PedestrianSpeed" parameterType="double" value="1.5" /></ParameterDeclarations><CatalogLocations><VehicleCatalog><Directory path="../xosc/Catalogs/Vehicles" /></VehicleCatalog><RouteCatalog><Directory path="../xosc/Catalogs/Routes" /></RouteCatalog></CatalogLocations><RoadNetwork><LogicFile filepath="../xodr/fabriksgatan.xodr" /><SceneGraphFile filepath="../models/fabriksgatan.osgb" /></RoadNetwork><Entities><ScenarioObject name="Ego"><CatalogReference catalogName="VehicleCatalog" entryName="$HostVehicle" /></ScenarioObject><ScenarioObject name="pedestrian_adult"><Pedestrian name="pedestrian_adult" mass="80.0" model="EPTa" pedestrianCategory="pedestrian" model3d="../models/walkman.osgb" /></ScenarioObject></Entities><Storyboard><Init><Actions><Private entityRef="Ego"><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionTarget><AbsoluteTargetSpeed value="$HostSpeed" /></SpeedActionTarget><SpeedActionDynamics dynamicsDimension="time" dynamicsShape="step" value="0.0" /></SpeedAction></LongitudinalAction></PrivateAction></Private><Private entityRef="pedestrian_adult"><PrivateAction><TeleportAction><Position><LanePosition roadId="0" laneId="3" s="15.0" offset="0.5" /></Position></TeleportAction></PrivateAction></Private></Actions></Init><Story name="LTAPStory"><ParameterDeclarations><ParameterDeclaration name="owner" parameterType="string" value="NPC" /></ParameterDeclarations><Act name="LTAPActNPC"><ManeuverGroup name="ped_mangroup" maximumExecutionCount="1"><Actors selectTriggeringEntities="false"><EntityRef entityRef="pedestrian_adult" /></Actors><Maneuver name="ped_maneuver"><Event name="ped_event" priority="overwrite"><Action name="walk_speed"><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionTarget><AbsoluteTargetSpeed value="$PedestrianSpeed" /></SpeedActionTarget><SpeedActionDynamics dynamicsDimension="rate" dynamicsShape="linear" value="2.0" /></SpeedAction></LongitudinalAction></PrivateAction></Action><Action name="walk_route" /><StartTrigger><ConditionGroup><Condition name="ped_walk_event" delay="0.0" conditionEdge="rising"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Ego" /></TriggeringEntities></ByEntityCondition></Condition></ConditionGroup></StartTrigger></Event></Maneuver></ManeuverGroup><ManeuverGroup name="brake-for-ped_mangroup" maximumExecutionCount="1"><Actors selectTriggeringEntities="false"><EntityRef entityRef="Ego" /></Actors><Maneuver name="brake_Maneuver"><Event name="brake_Event" priority="overwrite"><Action name="brake_Action"><PrivateAction><LongitudinalAction><SpeedAction><SpeedActionTarget><AbsoluteTargetSpeed value="0.0" /></SpeedActionTarget><SpeedActionDynamics dynamicsDimension="rate" dynamicsShape="linear" value="-5.1" /></SpeedAction></LongitudinalAction></PrivateAction></Action><StartTrigger><ConditionGroup><Condition name="brake_Condition" delay="0.0" conditionEdge="rising"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="Ego" /></TriggeringEntities></ByEntityCondition></Condition></ConditionGroup></StartTrigger></Event></Maneuver></ManeuverGroup><StartTrigger><ConditionGroup><Condition name="ActStartCondition" delay="0.0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition rule="greaterThan" value="0.0" /></ByValueCondition></Condition></ConditionGroup></StartTrigger></Act></Story><StopTrigger><ConditionGroup><Condition name="QuitCondition" delay="0.0" conditionEdge="rising"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="pedestrian_adult" /></TriggeringEntities></ByEntityCondition></Condition></ConditionGroup></StopTrigger></Storyboard></OpenSCENARIO>